#Communication avec caméra
CERNO_CAMERA_IP=192.168.?.?
CERNO_CAMERA_USERNAME=
CERNO_CAMERA_PASSWORD=?????
CERNO_CAMERA_URL=rtsp://USERNAME:PASSWORD@192.168.?.??:554/stream1

CERNO_PYTHON_PATH=/home/Projets/cerno-verdict/....
CERNO_CAMERA_CONTROLLER_PATH=/home/Projets/.....

CAMERA_IDLE_TIMEOUT_SECONDS=10

# Communication avec Vigile
COMMUNICATION_MODE=TCP

TCP_HOST=192.168.?.??
TCP_PORT=5000

UART_DEVICE=/dev/ttyUSB0
UART_BAUDRATE=115200
